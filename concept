<script>
// Preserve each element's rotation on hover
document.querySelectorAll('.idea').forEach(el => {
  const m = el.style.transform.match(/rotate\(([^)]+)\)/);
  const rot = m ? m[1] : '0deg';
  el.addEventListener('mouseenter', () => {
    el.style.transform = `scale(1.1) rotate(${rot})`;
  });
  el.addEventListener('mouseleave', () => {
    el.style.transform = `scale(1) rotate(${rot})`;
  });
});
</script>
